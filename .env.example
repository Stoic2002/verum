# ═══════════════════════════════════════════════════════════════════════════
#  VERUM — konfigurasi environment
#
#  Salin ke .env, lalu isi seperlunya. .env di-gitignore; file ini tidak.
#
#  PENTING: untuk menjalankan project ini sekarang, Anda TIDAK PERLU
#  mengisi apa pun kecuali blok Fase 1 dan Fase 2. Semua blok lain punya
#  perilaku pengganti yang berjalan lokal tanpa akun apa pun, dan setiap
#  blok menjelaskan apa yang terjadi kalau dibiarkan kosong.
#
#  Awalan PUBLIC_ adalah aturan SvelteKit: variabel itu ikut terkirim ke
#  browser pembaca. Yang tanpa awalan itu hanya ada di server — jangan
#  pernah menambahkan PUBLIC_ ke sesuatu yang rahasia.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Fase 1 · database ──────────────────────────────────── WAJIB ──────────
#
# PostgreSQL. Nilai di bawah cocok dengan `bun run db:setup`.
#
DATABASE_URL="postgres://verum:verum@localhost:5432/verum"
# Database terpisah untuk test integrasi. Isinya dihapus setiap test jalan.
DATABASE_URL_TEST="postgres://verum:verum@localhost:5432/verum_test"


# ─── Fase 2 · auth ──────────────────────────────────────── WAJIB ──────────
#
# Kunci acak untuk menandatangani cookie session admin.
# Buat dengan:  openssl rand -base64 32
#
# Menggantinya = semua session admin logout. Aman dilakukan kapan saja.
#
SESSION_SECRET=""

# Hanya perlu di PRODUKSI, di balik Caddy + Cloudflare.
#
# Tanpa ini, semua request terlihat datang dari satu IP proxy — rate limit
# login akan memblokir SEMUA orang sekaligus dan tidak berguna sama sekali.
#
# CF-Connecting-IP ditulis Cloudflare dan tidak bisa dipalsukan klien SELAMA
# origin hanya menerima koneksi dari Cloudflare (firewall ke IP range mereka).
# Kalau origin bisa dihubungi langsung, header ini bisa dipalsukan siapa pun.
#
# Biarkan kosong saat pengembangan lokal.
ADDRESS_HEADER=""
XFF_DEPTH="1"


# ─── Fase 3 · konten ────────────────────────────────────── WAJIB ──────────
#
# Kunci untuk menandatangani link preview draft (HMAC).
# Buat dengan:  openssl rand -base64 32
#
# Menggantinya = semua link preview yang beredar langsung mati. Itu satu-
# satunya cara mencabut link preview, dan memang disengaja begitu.
#
PREVIEW_TOKEN_SECRET=""


# ─── Seed (opsional, hanya untuk data contoh) ──────────────────────────────
#
# Dipakai `bun run db:seed`. Kosong = admin@verum.local / verum-dev-password.
# Seed menolak database yang bukan localhost kecuali SEED_FORCE=1.
#
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""


# ─── Fase 4 · penyimpanan gambar ────────────────────────── OPSIONAL ───────
#
# Cloudflare R2 = tempat menyimpan file gambar, di luar server ini.
# Mirip Google Drive tapi untuk aplikasi. Dipilih karena biaya transfer
# keluarnya nol — faktor penentu untuk situs yang penuh gambar (PRD §10.2).
#
# KOSONG  → upload ditulis ke folder .media/ di komputer ini dan disajikan
#           lewat /media/... Cukup untuk pengembangan dan CI.
# TERISI  → upload masuk ke R2 dan disajikan dari domain bucket-nya.
#
# Mengisi SEBAGIAN adalah error yang menggagalkan start, bukan fallback
# diam-diam: deploy produksi yang kurang satu variabel akan menulis upload
# ke disk container dan kehilangan semuanya saat restart berikutnya.
#
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# URL publik bucket, biasanya custom domain. Contoh: https://img.verum.example
R2_PUBLIC_URL=""

# Folder tujuan saat R2 kosong. Sudah di-gitignore.
MEDIA_FS_DIR=".media"


# ─── Fase 5 · identitas situs ───────────────────────────── OPSIONAL ───────
#
# Dipakai untuk canonical URL, Open Graph, sitemap, dan RSS.
# Ganti PUBLIC_SITE_URL ke domain asli saat deploy.
#
PUBLIC_SITE_URL="http://localhost:5173"
PUBLIC_SITE_NAME="VERUM"

# WAJIB saat menjalankan hasil build (`node build/index.js`), termasuk di
# produksi. Isi dengan origin situs, tanpa slash di akhir.
#
# adapter-node menolak SEMUA POST form yang origin-nya tidak cocok — proteksi
# CSRF bawaan SvelteKit. Tanpa ORIGIN, server tidak tahu alamatnya sendiri,
# jadi login dan setiap form action mengembalikan 403 "Cross-site POST form
# submissions are forbidden". `vite dev` dan `vite preview` tahu sendiri, jadi
# masalahnya hanya muncul di build produksi.
#
# Alternatif di balik proxy: PROTOCOL_HEADER=x-forwarded-proto dan
# HOST_HEADER=x-forwarded-host. ORIGIN lebih sederhana dan lebih sulit salah.
ORIGIN=""

# Alamat kontak yang tampil di halaman Kontak, Privasi, dan Kebijakan Editorial.
# WAJIB sebelum daftar AdSense: halaman Kontak tanpa cara menghubungi
# menggagalkan justru syarat yang halaman itu ada untuk memenuhinya (PRD §14).
PUBLIC_CONTACT_EMAIL=""

# Tanggal "terakhir diperbarui" di halaman kebijakan. Diisi tangan, bukan
# otomatis: tanggal yang bergerak tiap deploy mengklaim peninjauan yang tidak
# pernah terjadi.
PUBLIC_POLICY_UPDATED="2026-09-10"


# ─── Fase 6 · pengiriman email ──────────────────────────── OPSIONAL ───────
#
# SMTP = protokol standar untuk mengirim email. Bukan nama perusahaan —
# ini "kantor pos" yang aplikasi titipi email untuk dikirimkan.
#
# VERUM memakainya untuk SATU hal: mengirim link konfirmasi saat seseorang
# mendaftar newsletter. Tanpa itu, tidak ada yang pernah masuk ke list.
#
# Anda butuh akun di penyedia yang menjalankan server SMTP. Kandidat:
#   · Resend      — 3.000 email/bulan gratis, paling mudah dipasang
#   · Postmark    — reputasi deliverability terbaik, berbayar
#   · Gmail       — bisa, dengan App Password, tapi berbatas dan bukan
#                   untuk pengiriman massal
#
# KOSONG  → email ditulis ke buffer di memori dan bisa dibaca di
#           /admin/mail. Alur double opt-in berjalan penuh dan teruji.
# TERISI  → email benar-benar terkirim, dan /admin/mail berhenti ada.
#
# Mengisi SEBAGIAN adalah error. Alasannya spesifik: form pendaftaran yang
# menerima alamat lalu diam-diam tidak pernah mengirim konfirmasi terlihat
# persis seperti form yang bekerja — dan baru ketahuan saat Anda bertanya-
# tanya kenapa tidak ada subscriber sama sekali.
#
# BARU DIBUTUHKAN saat newsletter diaktifkan (bulan 4–6). Bukan untuk launch.
#
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Alamat pengirim yang dilihat pembaca. Domainnya harus milik Anda.
MAIL_FROM="VERUM <hello@example.com>"


# ─── Fase 7 · purge cache CDN ───────────────────────────── OPSIONAL ───────
#
# Artikel yang terbit di-cache Cloudflare selama 24 jam. Saat Anda mengedit
# artikel, salinan lama harus dibuang paksa — kalau tidak, perbaikan Anda
# baru terlihat pembaca sehari kemudian.
#
# Zone ID ada di dashboard Cloudflare, halaman domain, kolom kanan.
# API token dibuat di My Profile → API Tokens, izin: Zone → Cache Purge.
#
# KOSONG → purge dilewati. Aman untuk lokal; di produksi artinya edit
#          Anda tertunda sampai TTL habis.
#
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""

# Isi baris ads.txt dari dashboard AdSense, mis.
#   google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
# Kosong = /ads.txt mengembalikan 404, yang lebih baik daripada file berisi
# placeholder: verifier memperlakukan deklarasi rusak lebih buruk daripada
# tidak ada file sama sekali (PRD §13.2).
ADS_TXT=""


# ─── Fase 8 · pemantauan ────────────────────────────────── OPSIONAL ───────
#
# Sentry = pelacak error. Saat halaman gagal untuk seorang pembaca jam 3
# pagi, Sentry menangkap error-nya lengkap dengan baris kode penyebabnya
# dan mengirimi Anda notifikasi.
#
# Tanpa itu, Anda baru tahu ada yang rusak kalau ada yang memberi tahu,
# atau saat kebetulan membaca log server. Untuk satu orang yang mengurus
# semuanya sendiri, ini selisih antara tahu dan tidak tahu.
#
# Free tier cukup jauh untuk skala VERUM. DSN bukan rahasia — ia hanya
# alamat tujuan laporan.
#
# Dua variabel karena error bisa terjadi di dua tempat: di server, dan di
# browser pembaca. Yang PUBLIC_ ikut ke browser; itu memang seharusnya.
#
PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# Analytics pembaca. Opsional — lihat docs/PLAN-DEV.md §L.4.
# Search Console + tabel article_stats sudah menutup empat dari lima metrik
# yang dipantau PRD §3. Yang hilang hanya sumber referral.
PUBLIC_ANALYTICS_DOMAIN=""
