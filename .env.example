# Copy to .env and fill in. .env is gitignored; this file is not.
# Every variable VERUM will use through Fase 8 is listed here, so a missing
# value is a lookup, never a surprise at deploy time.

# ─── Fase 1 · database ────────────────────────────────────────────────────────
DATABASE_URL="postgres://verum:verum@localhost:5432/verum"
# Used by integration tests in Fase 1. Wiped freely.
DATABASE_URL_TEST="postgres://verum:verum@localhost:5432/verum_test"

# ─── Fase 2 · auth ────────────────────────────────────────────────────────────
# openssl rand -base64 32
SESSION_SECRET=""

# ─── Fase 3 · content ─────────────────────────────────────────────────────────
# HMAC secret for draft preview links. openssl rand -base64 32
PREVIEW_TOKEN_SECRET=""

# ─── Fase 4 · media (Cloudflare R2) ───────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL images are served from (custom domain on the bucket)
R2_PUBLIC_URL=""

# ─── Fase 5 · site ────────────────────────────────────────────────────────────
PUBLIC_SITE_URL="http://localhost:5173"
PUBLIC_SITE_NAME="VERUM"

# ─── Fase 6 · newsletter ──────────────────────────────────────────────────────
# Provider still open (PRD §18.4). Buttondown by default.
NEWSLETTER_PROVIDER="buttondown"
NEWSLETTER_API_KEY=""

# ─── Fase 7 · CDN cache purge ─────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""

# ─── Produksi · alamat klien di balik proxy ───────────────────────────────────
# WAJIB di produksi. adapter-node membaca alamat klien dari header ini.
#
# Tanpa ini, di balik Caddy + Cloudflare SETIAP request terlihat datang dari
# satu IP proxy — rate limit login akan memblokir semua orang sekaligus, dan
# tidak ada gunanya sama sekali.
#
# CF-Connecting-IP ditulis Cloudflare dan tidak bisa dipalsukan klien SELAMA
# origin hanya menerima koneksi dari Cloudflare (firewall ke IP range mereka).
# Kalau origin bisa dihubungi langsung, header ini bisa dipalsukan siapa pun.
# Jangan diisi saat pengembangan lokal.
ADDRESS_HEADER=""
XFF_DEPTH="1"

# ─── Fase 8 · ops ─────────────────────────────────────────────────────────────
PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Plausible self-hosted or GA4 (PRD §18.3)
PUBLIC_ANALYTICS_DOMAIN=""
